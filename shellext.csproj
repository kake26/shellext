<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The binary must be named 'x': argv[0]-mode dispatch and all help text
         assume it. Symlinks (x install) point at this name. -->
    <AssemblyName>x</AssemblyName>
    <!-- SemVer; shown by 'x version'. Bump per release, tag the check-in
         (fossil tag add rel-X.Y.Z). -->
    <Version>1.0.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- For calling .so applet exports: unmanaged function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned, not floating: this package ships a native library, and
         reproducible builds matter more than silent major bumps. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="shellext-tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests are their own project; keep them out of the main build. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Content Remove="tests/**" />
  </ItemGroup>

</Project>
