<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The binary must be named 'x': argv[0]-mode dispatch and all help text
         assume it. Symlinks (x install) point at this name. -->
    <AssemblyName>x</AssemblyName>
    <!-- SemVer; shown by 'x version'. Bump per release, tag the check-in
         (fossil tag add rel-X.Y.Z). -->
    <Version>1.0.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- For calling .so applet exports: unmanaged function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

</Project>
